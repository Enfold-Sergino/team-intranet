# Copy to .env. Never commit real values: this repo is public.

# Where content comes from: plate (default) or demo (invented content, no CMS needed).
# CONTENT_SOURCE=plate

# Site languages, code:label:name:root (default below).
# SITE_LANGUAGES=en-GB:EN:English:/,nl-NL:NL:Nederlands:/nl

# Plate Content Delivery API, channel-scoped token (Plate → API tokens). Keep private.
# PLATE_DELIVERY_TOKEN=
# PLATE_CDA_URL=

# Plate languages per site language, so items are split per language: code=<prn>|<prn>;code=<prn>
# PLATE_LANGUAGE_PRNS=en-GB=<prn>|<prn>;nl-NL=<prn>

# Page served at each language root when the root has no page of its own (default /home).
# PLATE_HOME_PATH=/home
