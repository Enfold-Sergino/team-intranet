---
import type { Site } from "@team-intranet/core";
import NavTree from "./NavTree.astro";

interface Props {
  site: Site;
  currentPath: string;
}
const { site, currentPath } = Astro.props;
---

<aside
  id="sidebar"
  data-sidebar
  aria-label="Site navigation"
  class="fixed inset-y-0 left-0 z-30 w-72 -translate-x-full overflow-y-auto border-r border-line bg-surface p-4 pt-20 transition-transform data-open:translate-x-0 lg:sticky lg:top-16 lg:z-0 lg:h-[calc(100vh-4rem)] lg:translate-x-0 lg:pt-4"
>
  <label class="sr-only" for="nav-filter">
    Filter pages
  </label>
  <input
    id="nav-filter"
    type="search"
    placeholder="Filter pages"
    autocomplete="off"
    data-nav-filter
    class="mb-3 w-full rounded-lg border border-line bg-canvas px-3 py-1.5 text-sm"
  />
  <nav aria-label="Pages">
    <NavTree nodes={site.navigation()} site={site} currentPath={currentPath} />
  </nav>
  <p data-nav-empty hidden class="px-2 text-sm text-ink-muted">
    No pages match.
  </p>
</aside>

<script>
  const input = document.querySelector<HTMLInputElement>("[data-nav-filter]");
  const empty = document.querySelector<HTMLElement>("[data-nav-empty]");
  const items = [...document.querySelectorAll<HTMLLIElement>("[data-nav-item]")].reverse();
  input?.addEventListener("input", () => {
    const query = input.value.trim().toLowerCase();
    let visible = 0;
    // Bottom-up, so a parent stays visible when one of its children matches.
    for (const item of items) {
      const child = item.querySelector("[data-nav-item]:not([hidden])") !== null;
      item.hidden = Boolean(query) && !(item.dataset.title ?? "").includes(query) && !child;
      if (query && child) item.querySelector("details")?.setAttribute("open", "");
      if (!item.hidden) visible++;
    }
    if (empty) empty.hidden = visible > 0;
  });
</script>
