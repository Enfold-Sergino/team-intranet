---
import { withBase } from "../../lib/url";

interface Props {
  href: string;
  variant?: "primary" | "secondary";
}
const { href, variant = "primary" } = Astro.props;
---

<a
  href={withBase(href)}
  class:list={[
    "inline-flex items-center gap-2 rounded-lg px-4 py-2 font-medium no-underline transition-colors",
    variant === "primary"
      ? "bg-accent text-on-accent hover:bg-accent-strong hover:text-on-accent"
      : "border border-line bg-surface text-ink hover:bg-surface-muted",
  ]}
>
  <slot />
</a>
