---
interface Props {
  title?: string | null;
  intro?: string | null;
}
const { title, intro } = Astro.props;
---

{(title || intro) && (
  <header class="mb-4">
    {title && <h2 class="text-xl font-semibold tracking-tight">{title}</h2>}
    {intro && <p class="mt-1 text-ink-muted">{intro}</p>}
  </header>
)}
