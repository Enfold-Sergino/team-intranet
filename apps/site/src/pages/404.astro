---
import Button from "../components/ui/Button.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found">
  <main class="mx-auto flex min-h-screen max-w-xl flex-col items-start justify-center gap-4 p-8">
    <p class="text-6xl font-bold text-accent">404</p>
    <h1 class="text-2xl font-semibold">This page does not exist (anymore)</h1>
    <p class="text-ink-muted">It may have been moved or unpublished.</p>
    <Button href="/">Go to the homepage</Button>
  </main>
</BaseLayout>
