---
import Button from "../components/ui/Button.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found">
  <script is:inline define:vars={{ base: import.meta.env.BASE_URL }}>
    // The live editor loads <site>/editor/content-experiences/<path>: a static host has no such
    // file, so every editor URL goes to the one preview page.
    (function () {
      const root = base.replace(/\/?$/, "/");
      if (
        location.pathname.indexOf(root + "editor/") === 0 &&
        location.pathname !== root + "editor/"
      )
        location.replace(root + "editor/" + location.search + location.hash);
    })();
  </script>
  <main class="mx-auto flex min-h-screen max-w-xl flex-col items-start justify-center gap-4 p-8">
    <p class="text-6xl font-bold text-accent">404</p>
    <h1 class="text-2xl font-semibold">This page does not exist (anymore)</h1>
    <p class="text-ink-muted">It may have been moved or unpublished.</p>
    <Button href="/">Go to the homepage</Button>
  </main>
</BaseLayout>
