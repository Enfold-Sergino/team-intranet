---
import type { BlockProps } from "@team-intranet/core";
import Button from "../components/ui/Button.astro";
import Icon from "../components/ui/Icon.astro";
import RichText from "../components/ui/RichText.astro";
import { withBase } from "../lib/url";

type Props = BlockProps<"hero">;
const { title, intro, image, ctaLabel, ctaLink } = Astro.props;
---

<section
  class:list={[
    "grid items-center gap-6 rounded-2xl bg-accent-soft p-8",
    { "md:grid-cols-2": image },
  ]}
>
  <div class="flex flex-col items-start gap-4">
    {title && <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">{title}</h1>}
    <RichText content={intro} class="text-lg" />
    {ctaLabel && ctaLink && (
      <Button href={ctaLink.path}>
        {ctaLabel} <Icon name="arrow" size={16} />
      </Button>
    )}
  </div>
  {image && (
    <img
      src={withBase(image.url)}
      alt={image.alt ?? ""}
      width="1200"
      height="600"
      class="w-full rounded-xl object-cover"
    />
  )}
</section>
