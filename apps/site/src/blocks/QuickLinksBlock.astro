---
import type { BlockProps } from "@team-intranet/core";
import Icon from "../components/ui/Icon.astro";
import Link from "../components/ui/Link.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import { isExternal } from "../lib/url";

type Props = BlockProps<"quick-links">;
const { title } = Astro.props;
const links = Astro.props.links.flatMap(({ title, url, description }) =>
  title && url ? [{ title, url, description }] : [],
);
---

{links.length > 0 && (
  <section>
    <SectionHeading title={title} />
    <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {links.map((link) => (
        <li>
          <Link
            href={link.url}
            class="flex h-full flex-col rounded-xl border border-line bg-surface p-4 no-underline hover:border-accent"
          >
            <span class="flex items-center gap-1 font-medium">
              {link.title}
              {isExternal(link.url) && (
                <Icon name="external" size={14} label="(opens in a new tab)" />
              )}
            </span>
            {link.description && <span class="text-sm text-ink-muted">{link.description}</span>}
          </Link>
        </li>
      ))}
    </ul>
  </section>
)}
