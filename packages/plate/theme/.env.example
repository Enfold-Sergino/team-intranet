# Settings for `pnpm plate:sync`: copy to packages/plate/theme/.env. Never commit real values.

# The full PRN of the theme in Plate (prn:plate-prod:<organisation>:…:<id>), not just the ID:
# a bare ID makes Plate answer 500.
# PLATE_THEME_PRN=

# Optional: the Delta CLI profile to use (default: the CLI's default profile).
# PLATE_DELTA_PROFILE=
